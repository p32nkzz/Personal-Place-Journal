{
  "name": "ppj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "db:reset": "tsx --env-file=.env scripts/reset-db.ts",
    "i18n:check": "node scripts/check-keys.mjs",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "@fancyapps/ui": "^5.0.36",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.41.0",
    "jquery": "^3.7.1",
    "mysql2": "^3.11.0",
    "next": "^15.2.3",
    "next-auth": "5.0.0-beta.25",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "select2": "^4.0.13",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "superjson": "^2.2.1",
    "uuid": "^14.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/archiver": "^8.0.0",
    "@types/google.maps": "^3.66.6",
    "@types/jquery": "^3.5.34",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/select2": "^4.0.63",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@10.9.9"
}
